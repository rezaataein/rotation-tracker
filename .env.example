# ============================================================================
# ROTATION TRACKER - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to GitHub - it contains secrets!
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get these from: Supabase Dashboard → Settings → API

# Your Supabase project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Public anon key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# ⚠️ Service role key (NEVER expose in frontend, only use in GitHub Actions)
# This key bypasses Row-Level Security - keep it SECRET!
# SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# ============================================================================
# PYTHON MONITOR SCRIPT (used by .github/scripts/monitor.py)
# ============================================================================
# No VITE_ prefix - these are for backend Python script only

# Supabase URL (same as above)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# ⚠️ Service role key from Supabase Dashboard → Settings → API
# Get the "service_role" key (NOT the anon key)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# ============================================================================
# WEB PUSH NOTIFICATIONS (VAPID)
# ============================================================================
# Generate these using: node -e "const webpush = require('web-push'); const keys = webpush.generateVAPIDKeys(); console.log(keys);"

# VAPID public key (safe to expose in frontend)
VITE_VAPID_PUBLIC_KEY=YOUR_PUBLIC_KEY_HERE

# ⚠️ VAPID private key (NEVER expose, only use in GitHub Actions)
# VAPID_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# ============================================================================
# OPTIONAL: DEVELOPMENT/PRODUCTION FLAGS
# ============================================================================
NODE_ENV=development

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit this file with real values
# 2. Add .env to .gitignore (already done)
# 3. Store secrets in GitHub Secrets for Actions
# 4. Use import.meta.env.VITE_* in Vite app code
# 5. Prefix VITE_* for Vite to expose to frontend (replaces REACT_APP_* from create-react-app)
# 6. Keys without VITE_ prefix are only for backend (GitHub Actions)
